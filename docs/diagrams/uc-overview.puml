@startuml uc-overview
!include style.iuml
left to right direction
title SkillMatrix — przegląd przypadków użycia

actor "Kandydat" as K
actor "Agent ofert\n<<system>>" as AG
actor "Agent AI\n<<system>>" as AI
actor "GitHub API\n<<system>>" as GH
actor "Portal ofert\n<<system>>" as P

rectangle "Serwer SkillMatrix" {
  package "Konta" {
    usecase "UC-01 Załóż konto" as UC01
    usecase "UC-02 Zaloguj się" as UC02
    usecase "UC-13 Usuń konto" as UC13
  }
  package "Profil umiejętności" {
    usecase "UC-03 Dodaj materiały\n(CV, oceny)" as UC03
    usecase "UC-04 Importuj z GitHuba" as UC04
    usecase "UC-05 Oceń umiejętności" as UC05
    usecase "UC-06 Przeglądaj graf\numiejętności" as UC06
    usecase "UC-07 Popraw poziom ręcznie\n(niezalecane)" as UC07
  }
  package "Dopasowanie i rekomendacje" {
    usecase "UC-08 Przeglądaj\ndopasowane oferty" as UC08
    usecase "UC-09 Analizuj braki\ndla oferty" as UC09
    usecase "UC-10 Otrzymaj\nrekomendacje nauki" as UC10
  }
  package "CV" {
    usecase "UC-11 Oceń CV" as UC11
    usecase "UC-12 Wygeneruj CV" as UC12
  }
  package "Graf umiejętności" {
    usecase "UC-23 Zmapuj nazwę\nna węzeł grafu" as UC23
    usecase "UC-20 Dodaj nową\numiejętność" as UC20
    usecase "UC-21 Scal zduplikowane\numiejętności" as UC21
    usecase "UC-22 Wyznacz relacje\nmiędzy umiejętnościami" as UC22
  }
  package "Oferty pracy" {
    usecase "UC-30 Pobierz oferty" as UC30
    usecase "UC-31 Zamień ofertę\nna wymagania" as UC31
    usecase "UC-32 Wygaś nieaktualne\noferty" as UC32
  }
}

